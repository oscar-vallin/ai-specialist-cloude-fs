# Copy to .env and adjust. The real .env is git-ignored. Values below are
# placeholders for LOCAL DEVELOPMENT ONLY; never reuse them outside a local machine.

# PostgreSQL
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
# "local" loads the seed data (Flyway db/seed location). Never use "local" or "dev" in production.
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-me-local-only-use-at-least-32-characters
JWT_EXPIRATION_MINUTES=60

# Business configuration
APP_CURRENCY=USD
APP_GIFT_POINTS_PER_CURRENCY_UNIT=100
